<Page x:Class="MiracleShoesWPF.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MiracleShoesWPF.Pages"
      xmlns:app="clr-namespace:MiracleShoesWPF"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Margin="0,16">
            <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Имя:" Margin="4,0,0,0"/>
            <TextBox x:Name="FirstNameBox" MaxLength="100" app:Hint.Text="Например: Иван" ToolTip="Ваше имя"/>

            <TextBlock Text="Фамилия:" Margin="4,4,0,0"/>
            <TextBox x:Name="LastNameBox" MaxLength="100" app:Hint.Text="Например: Петров" ToolTip="Ваша фамилия"/>

            <TextBlock Text="Email:" Margin="4,4,0,0"/>
            <TextBox x:Name="EmailBox" MaxLength="150" app:Hint.Text="name@example.com" ToolTip="Email используется для входа"/>

            <TextBlock Text="Телефон (необязательно):" Margin="4,4,0,0"/>
            <TextBox x:Name="PhoneBox" MaxLength="20" app:Hint.Text="+7 900 111-22-33" ToolTip="Необязательное поле"/>

            <TextBlock Text="Пароль (не короче 6 символов):" Margin="4,4,0,0"/>
            <PasswordBox x:Name="PasswordInput" MaxLength="100" ToolTip="Минимум 6 символов"/>

            <TextBlock Text="Повторите пароль:" Margin="4,4,0,0"/>
            <PasswordBox x:Name="ConfirmInput" MaxLength="100"/>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap"
                       Margin="4,8,4,0" Visibility="Collapsed"/>

            <Button Content="Зарегистрироваться" IsDefault="True"
                    Margin="4,12,4,4" Click="RegisterButton_Click"/>
            <Button Content="Уже есть аккаунт? Войти" Click="ToLoginButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
