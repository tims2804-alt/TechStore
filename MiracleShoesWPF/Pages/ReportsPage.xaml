<Page x:Class="MiracleShoesWPF.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Отчёты и графики">

    <Page.Resources>
        <!-- Строка столбчатой диаграммы: подпись, столбец, значение -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="{Binding BarWidth}" Height="18" Background="#2563EB" CornerRadius="2"/>
                    <TextBlock Text="{Binding ValueText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Товары" ToolTip="Управление товарами магазина" Click="NavProducts_Click"/>
                <Button Content="Заказы магазина" ToolTip="Заказы покупателей" Click="NavOrders_Click"/>
                <Button Content="Отчёты" ToolTip="Отчёты и графики продаж" Click="NavReports_Click"/>
            </StackPanel>
            <TextBlock Text="Отчёты и графики продаж" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" FontSize="16"/>
            <TextBlock Text="В отчётах не учитываются отменённые заказы (кроме отчёта по статусам)."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>

            <TextBlock Text="Выручка по товарам" FontSize="18" FontWeight="SemiBold"/>
            <ItemsControl x:Name="ProductBars" ItemTemplate="{StaticResource BarTemplate}" Margin="0,4,0,16"/>

            <TextBlock Text="Выручка по категориям" FontSize="18" FontWeight="SemiBold"/>
            <ItemsControl x:Name="CategoryBars" ItemTemplate="{StaticResource BarTemplate}" Margin="0,4,0,16"/>

            <TextBlock Text="Количество заказов по статусам" FontSize="18" FontWeight="SemiBold"/>
            <ItemsControl x:Name="StatusBars" ItemTemplate="{StaticResource BarTemplate}" Margin="0,4,0,16"/>

            <TextBlock x:Name="EmptyText" Text="Данных для отчётов пока нет." Foreground="{DynamicResource MutedBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
