<Page x:Class="MiracleShoesWPF.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MiracleShoesWPF.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Корзина" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>

            <ItemsControl x:Name="CartList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,2" Background="{DynamicResource CardBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Shop, StringFormat='Магазин: {0}'}" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N0} ₽'}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Width="30" Padding="0,4" Click="Minus_Click"/>
                                    <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Button Content="+" Width="30" Padding="0,4" Click="Plus_Click"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>

                                <Button Grid.Column="4" Content="Удалить" Background="#DC2626"
                                        Click="Remove_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="Корзина пуста. Добавьте товары из каталога."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,16" Visibility="Collapsed"/>

            <Border x:Name="CheckoutPanel" Margin="0,16,0,0" Padding="12" CornerRadius="6"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" MaxWidth="460"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Оформление заказа" FontSize="16" FontWeight="SemiBold"/>

                    <TextBlock Text="Способ получения:" Margin="4,8,0,0"/>
                    <ComboBox x:Name="DeliveryBox" SelectedIndex="0"
                              SelectionChanged="DeliveryBox_SelectionChanged">
                        <ComboBoxItem Content="Курьер" Tag="courier"/>
                        <ComboBoxItem Content="Самовывоз" Tag="pickup"/>
                        <ComboBoxItem Content="Почта" Tag="post"/>
                    </ComboBox>

                    <TextBlock x:Name="AddressLabel" Text="Адрес доставки:" Margin="4,4,0,0"/>
                    <TextBox x:Name="AddressBox" MaxLength="255"/>

                    <TextBlock Text="Способ оплаты:" Margin="4,4,0,0"/>
                    <ComboBox x:Name="PaymentBox" SelectedIndex="0">
                        <ComboBoxItem Content="Банковская карта" Tag="card"/>
                        <ComboBoxItem Content="СБП" Tag="sbp"/>
                        <ComboBoxItem Content="При получении" Tag="cash_on_delivery"/>
                    </ComboBox>

                    <TextBlock x:Name="ShopsNote" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Margin="4,8,4,0"/>
                    <TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold" Margin="4,8,4,0"/>

                    <Button x:Name="CheckoutButton" Content="Оформить заказ" Margin="4,12,4,4"
                            Click="CheckoutButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
