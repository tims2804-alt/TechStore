<Page x:Class="MiracleShoesWPF.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MiracleShoesWPF.Pages"
      xmlns:app="clr-namespace:MiracleShoesWPF"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поиск, фильтр, сортировка -->
        <WrapPanel Grid.Row="0" Margin="8,8,8,0">
            <TextBox x:Name="SearchBox" Width="240" ToolTip="Поиск по названию товара" app:Hint.Text="Поиск по названию…"
                     TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="FilterBox" Width="180" ToolTip="Фильтр по категории" DisplayMemberPath="name"
                      SelectionChanged="FilterBox_SelectionChanged"/>
            <ComboBox x:Name="SortBox" Width="200" ToolTip="Сортировка" SelectedIndex="0"
                      SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="По умолчанию"/>
                <ComboBoxItem Content="Цена: по возрастанию"/>
                <ComboBoxItem Content="Цена: по убыванию"/>
                <ComboBoxItem Content="Название: А — Я"/>
            </ComboBox>
        </WrapPanel>

        <TextBlock x:Name="CountText" Grid.Row="1" Margin="12,4,8,0" Foreground="{DynamicResource MutedBrush}"/>

        <!-- Каталог -->
        <ListBox x:Name="CatalogListBox" Grid.Row="2" Margin="8"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="230" Margin="4" Padding="10" CornerRadius="6"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding name}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding categories.name}" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding description}" TextWrapping="Wrap"
                                       MaxHeight="40" TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding manufacturers.name, StringFormat='Производитель: {0}'}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding sellers.shop_name, StringFormat='Магазин: {0}'}"/>
                            <TextBlock Text="{Binding stock_quantity, StringFormat='В наличии: {0} шт.'}"/>
                            <TextBlock Text="{Binding price, StringFormat='{}{0:N0} ₽'}"
                                       FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                            <Button Click="AddToCart_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="В корзину"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding stock_quantity}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="Нет в наличии"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="По вашему запросу ничего не найдено"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
    </Grid>
</Page>
