<Page x:Class="MiracleShoesWPF.Pages.SellerOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Заказы магазина">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Товары" ToolTip="Управление товарами магазина" Click="NavProducts_Click"/>
                <Button Content="Заказы магазина" ToolTip="Заказы покупателей" Click="NavOrders_Click"/>
                <Button Content="Отчёты" ToolTip="Отчёты и графики продаж" Click="NavReports_Click"/>
            </StackPanel>
            <TextBlock Text="Заказы магазина" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>

            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="12" CornerRadius="6" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Buyer}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Items}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Payment}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Delivery}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Total}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{Binding NextText}" Visibility="{Binding NextVisibility}"
                                            ToolTip="Перевести заказ на следующий статус" Click="Next_Click"/>
                                    <Button Content="Отменить заказ" Background="#DC2626"
                                            Visibility="{Binding CancelVisibility}" Click="Cancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="Заказов пока нет." Foreground="{DynamicResource MutedBrush}"
                       Margin="0,12" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
