<Page x:Class="MiracleShoesWPF.Pages.SellerProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Товары магазина">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Товары" ToolTip="Управление товарами магазина" Click="NavProducts_Click"/>
                <Button Content="Заказы магазина" ToolTip="Заказы покупателей" Click="NavOrders_Click"/>
                <Button Content="Отчёты" ToolTip="Отчёты и графики продаж" Click="NavReports_Click"/>
            </StackPanel>
            <TextBlock x:Name="ShopTitle" FontSize="22" FontWeight="Bold"/>
            <Button Content="+ Добавить товар" HorizontalAlignment="Left" ToolTip="Создать новый товар"
                    Click="Add_Click"/>

            <ItemsControl x:Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,3" Background="{DynamicResource CardBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Stock, StringFormat='{}{0} шт.'}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Изменить" ToolTip="Редактировать товар" Click="Edit_Click"/>
                                    <Button Content="Удалить" Background="#DC2626" ToolTip="Удалить товар" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="В магазине пока нет товаров. Нажмите «Добавить товар»."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,12" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
