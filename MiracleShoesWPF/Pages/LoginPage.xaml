<Page x:Class="MiracleShoesWPF.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:app="clr-namespace:MiracleShoesWPF"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход в систему">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Margin="0,16">
            <TextBlock Text="Вход в TechStore" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="Email:" Margin="4,0,0,0"/>
            <TextBox x:Name="EmailBox" MaxLength="150" app:Hint.Text="name@example.com"
                     ToolTip="Email, указанный при регистрации"/>

            <TextBlock Text="Пароль:" Margin="4,8,0,0"/>
            <PasswordBox x:Name="PasswordInput" MaxLength="100" ToolTip="Ваш пароль"/>

            <!-- Капча появляется после трёх неверных попыток -->
            <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Введите символы с картинки:" Margin="4,0,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="4">
                        <Canvas x:Name="CaptchaCanvas" Width="200" Height="50"/>
                    </Border>
                    <Button Content="↻" ToolTip="Показать другой код" Click="RefreshCaptcha_Click"/>
                </StackPanel>
                <TextBox x:Name="CaptchaBox" MaxLength="6" app:Hint.Text="Код с картинки"
                         ToolTip="Регистр не важен"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap"
                       Margin="4,8,4,0" Visibility="Collapsed"/>

            <Button x:Name="LoginButton" Content="Войти" IsDefault="True"
                    Margin="4,16,4,4" Click="LoginButton_Click"/>
            <Button x:Name="RegisterButton" Content="Регистрация" ToolTip="Создать новый аккаунт"
                    Click="RegisterButton_Click"/>
            <Button x:Name="GuestButton" Content="Продолжить как гость"
                    ToolTip="Просмотр каталога без входа" Click="GuestButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
