<Page x:Class="MiracleShoesWPF.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MiracleShoesWPF.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои заказы">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Мои заказы" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>

            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="12" CornerRadius="6" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Shop}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Items}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Payment}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Delivery}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Total}" FontSize="18" FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="У вас пока нет заказов."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,16" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
